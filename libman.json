{
  "version": "3.0",
  "defaultProvider": "jsdelivr",
  "libraries": [
    {
      "library": "bootstrap@5.3.9",
      "destination": "wwwroot/lib/bootstrap/",
      "files": [
        "scss/**/*.*",
        "dist/**/*.*"
      ]
    },
    {
      // Please note: In three.module.min.js, the import from three.core.js must be manually 
      // changed to three.core.min.js, but this only needs to be done after an update.
      "library": "three@0.187.0",
      "destination": "wwwroot/lib/three/",
      "files": [
        "build/three.module.min.js",
        "build/three.core.min.js",
        "examples/jsm/loaders/OBJLoader.min.js"
      ]
    }
  ]
}